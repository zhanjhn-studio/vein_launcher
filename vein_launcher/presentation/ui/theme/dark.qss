/* Vein Launcher - 深色主题 */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #d7dbe4;
}

QMainWindow, QWidget#Content {
    background: #14161c;
}

QFrame#Sidebar {
    background: #0f1116;
    border-right: 1px solid #23262f;
}

QLabel#Brand {
    color: #7ee0c1;
    letter-spacing: 3px;
}

QLabel#BrandSub {
    color: #6b7280;
    font-size: 11px;
    letter-spacing: 1px;
}

QLabel#Hint {
    color: #6b7280;
    font-size: 11px;
}

QPushButton#NavButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    text-align: left;
    color: #9aa3b2;
}

QPushButton#NavButton:hover {
    background: #1b1f27;
    color: #e5e9f0;
}

QPushButton#NavButton:checked {
    background: #1d2a26;
    color: #7ee0c1;
    font-weight: 600;
}

QLabel#PageTitle {
    font-size: 20px;
    font-weight: 700;
    color: #f2f5fa;
}

QLabel#PageSubtitle {
    color: #7c8595;
    font-size: 12px;
}

QFrame#Card {
    background: #1a1d25;
    border: 1px solid #262a34;
    border-radius: 12px;
}

QPushButton {
    background: #232833;
    border: 1px solid #2f3542;
    border-radius: 8px;
    padding: 8px 16px;
    color: #d7dbe4;
}

QPushButton:hover {
    background: #2a3040;
    border-color: #3a4252;
}

QPushButton:pressed {
    background: #1f242e;
}

QPushButton#Primary {
    background: #2fbf9b;
    border: none;
    color: #06231c;
    font-weight: 700;
}

QPushButton#Primary:hover {
    background: #39d3ac;
}

QPushButton#Primary:disabled {
    background: #26443c;
    color: #54736a;
}

QPushButton#Danger {
    background: #3a2126;
    border-color: #5a2a33;
    color: #ff9aa8;
}

QLineEdit, QComboBox, QSpinBox, QPlainTextEdit, QListWidget, QTableWidget {
    background: #12151b;
    border: 1px solid #272c37;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #2fbf9b;
    selection-color: #06231c;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border-color: #2fbf9b;
}

QListWidget::item, QTableWidget::item {
    padding: 6px;
    border-radius: 6px;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background: #1d2a26;
    color: #7ee0c1;
}

QHeaderView::section {
    background: #1a1d25;
    color: #8b94a5;
    border: none;
    border-bottom: 1px solid #262a34;
    padding: 8px;
}

QProgressBar {
    background: #12151b;
    border: 1px solid #272c37;
    border-radius: 6px;
    text-align: center;
    height: 18px;
    color: #cfe9e1;
}

QProgressBar::chunk {
    background: #2fbf9b;
    border-radius: 5px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #2f3542;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #3b4354;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}

QStatusBar {
    background: #0f1116;
    color: #6b7280;
    border-top: 1px solid #23262f;
}

QTabWidget::pane {
    border: 1px solid #262a34;
    border-radius: 10px;
    background: #14161c;
}

QTabBar::tab {
    background: #1a1d25;
    color: #8b94a5;
    padding: 8px 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}

QTabBar::tab:selected {
    background: #1d2a26;
    color: #7ee0c1;
}
